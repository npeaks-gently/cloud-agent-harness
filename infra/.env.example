# Cloud Agent Harness — Infrastructure Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Used by: scripts/validate-phase1.ts
# Never commit .env — it contains secrets

# Database (from Secrets Manager after CDK deploy)
DATABASE_URL=postgresql://cah_admin:PASSWORD@DB_ENDPOINT:5432/cah

# S3 (from CDK stack output: BucketName)
S3_BUCKET=cah-dev-pipeline-bucket

# SQS (from CDK stack output: QueueUrl)
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/cah-dev-jobs

# Daytona (from https://app.daytona.io/dashboard — API Keys)
DAYTONA_API_KEY=

# Anthropic (from https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Repository to clone into Daytona sandbox for testing
REPO_URL=https://github.com/your-org/your-repo.git
